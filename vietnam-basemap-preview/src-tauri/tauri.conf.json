{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vietnam Basemap Preview",
  "version": "0.1.0",
  "identifier": "com.vietnam-basemap.preview",
  "build": {
    "beforeDevCommand": "npm run dev:basemap-preview",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build:basemap-preview",
    "frontendDist": "../../dist-basemap-preview"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vietnam Basemap Preview",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' https://mt1.google.com http://127.0.0.1:1421 ipc: http://ipc.localhost; img-src 'self' data: blob: https://mt1.google.com asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
