{
  "version": 8,
  "name": "Vietnam Basemap Engineering",
  "metadata": {
    "vietnam-basemap:styleId": "engineering",
    "vietnam-basemap:contractVersion": "1",
    "vietnam-basemap:offlineAssets": true
  },
  "sources": {
    "vn-basemap": {
      "type": "vector",
      "tiles": ["{basemap-tiles}/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 18
    }
  },
  "glyphs": "{basemap-glyphs}/{fontstack}/{range}.pbf",
  "sprite": "{basemap-sprite}/basemap",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#edf0f2" } },
    { "id": "landcover", "type": "fill", "source": "vn-basemap", "source-layer": "landcover", "paint": { "fill-color": "#e3e9e3", "fill-opacity": 0.6 } },
    { "id": "landuse", "type": "fill", "source": "vn-basemap", "source-layer": "landuse", "paint": { "fill-color": "#e8e5da", "fill-opacity": 0.65 } },
    { "id": "water", "type": "fill", "source": "vn-basemap", "source-layer": "water", "paint": { "fill-color": "#c8dfeb" } },
    { "id": "waterway", "type": "line", "source": "vn-basemap", "source-layer": "waterway", "paint": { "line-color": "#76b4cd", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.7, 14, 2.4] } },
    { "id": "building", "type": "fill", "source": "vn-basemap", "source-layer": "building", "paint": { "fill-color": "#d1d5d8", "fill-outline-color": "#aeb6bc", "fill-opacity": 0.85 } },
    { "id": "boundary", "type": "line", "source": "vn-basemap", "source-layer": "boundary", "paint": { "line-color": "#7b6b91", "line-dasharray": [2, 2], "line-width": 1.1 } },
    { "id": "railway", "type": "line", "source": "vn-basemap", "source-layer": "railway", "paint": { "line-color": "#69747c", "line-dasharray": [2, 2], "line-width": 1.3 } },
    { "id": "ferry-route", "type": "line", "source": "vn-basemap", "source-layer": "ferry", "paint": { "line-color": "#4f93b4", "line-dasharray": [1, 1], "line-width": 1.5 } },
    { "id": "road-major", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "filter": ["in", ["get", "class"], "motorway", "trunk", "primary"], "paint": { "line-color": "#c66e31", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.9, 12, 3.8, 16, 7.2] } },
    { "id": "road-minor", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 4.2] } },
    { "id": "airport-label", "type": "symbol", "source": "vn-basemap", "source-layer": "airport", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#3c4952", "text-halo-color": "#edf0f2", "text-halo-width": 1 } },
    { "id": "place-label", "type": "symbol", "source": "vn-basemap", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 14, 15] }, "paint": { "text-color": "#26323b", "text-halo-color": "#edf0f2", "text-halo-width": 1.2 } },
    { "id": "poi-label", "type": "symbol", "source": "vn-basemap", "source-layer": "poi", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#3c4952", "text-halo-color": "#edf0f2", "text-halo-width": 1 } }
  ]
}
