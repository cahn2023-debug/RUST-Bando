{
  "version": 8,
  "name": "Vietnam Basemap Dark",
  "metadata": {
    "vietnam-basemap:styleId": "dark",
    "vietnam-basemap:contractVersion": "1",
    "vietnam-basemap:offlineAssets": true
  },
  "sources": {
    "vn-basemap": {
      "type": "vector",
      "tiles": ["{basemap-tiles}/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 18
    }
  },
  "glyphs": "{basemap-glyphs}/{fontstack}/{range}.pbf",
  "sprite": "{basemap-sprite}/basemap",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#1c2229" } },
    { "id": "landcover", "type": "fill", "source": "vn-basemap", "source-layer": "landcover", "paint": { "fill-color": "#26332f", "fill-opacity": 0.8 } },
    { "id": "landuse", "type": "fill", "source": "vn-basemap", "source-layer": "landuse", "paint": { "fill-color": "#2b3036", "fill-opacity": 0.8 } },
    { "id": "water", "type": "fill", "source": "vn-basemap", "source-layer": "water", "paint": { "fill-color": "#1d4358" } },
    { "id": "waterway", "type": "line", "source": "vn-basemap", "source-layer": "waterway", "paint": { "line-color": "#2f6e8d", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 14, 2.2] } },
    { "id": "building", "type": "fill", "source": "vn-basemap", "source-layer": "building", "paint": { "fill-color": "#3a4148", "fill-outline-color": "#515a63", "fill-opacity": 0.9 } },
    { "id": "boundary", "type": "line", "source": "vn-basemap", "source-layer": "boundary", "paint": { "line-color": "#8c75a8", "line-dasharray": [2, 2], "line-width": 1 } },
    { "id": "railway", "type": "line", "source": "vn-basemap", "source-layer": "railway", "paint": { "line-color": "#9a9da0", "line-dasharray": [2, 2], "line-width": 1.2 } },
    { "id": "ferry-route", "type": "line", "source": "vn-basemap", "source-layer": "ferry", "paint": { "line-color": "#4b88ac", "line-dasharray": [1, 1], "line-width": 1.4 } },
    { "id": "road-major", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "filter": ["in", ["get", "class"], "motorway", "trunk", "primary"], "paint": { "line-color": "#e2a15c", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 12, 3.5, 16, 7] } },
    { "id": "road-minor", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "paint": { "line-color": "#7f8992", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 4] } },
    { "id": "airport-label", "type": "symbol", "source": "vn-basemap", "source-layer": "airport", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#c8d0d8", "text-halo-color": "#1c2229", "text-halo-width": 1 } },
    { "id": "place-label", "type": "symbol", "source": "vn-basemap", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 14, 15] }, "paint": { "text-color": "#e7eaed", "text-halo-color": "#1c2229", "text-halo-width": 1.2 } },
    { "id": "poi-label", "type": "symbol", "source": "vn-basemap", "source-layer": "poi", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#c8d0d8", "text-halo-color": "#1c2229", "text-halo-width": 1 } }
  ]
}
