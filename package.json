{
  "name": "project-manager-repository-entrypoint",
  "private": true,
  "version": "1.0.0",
  "description": "Repository entrypoint delegating to the Project Manager workspace",
  "scripts": {
    "dev": "npm --prefix apps/project-manager run dev",
    "build": "npm --prefix apps/project-manager run build",
    "preview": "npm --prefix apps/project-manager run preview",
    "tauri": "npm --prefix apps/project-manager run tauri --",
    "build:msi": "npm --prefix apps/project-manager run build:msi",
    "typecheck": "npm --prefix apps/project-manager run typecheck",
    "test": "npm --prefix apps/project-manager run test",
    "test:ci": "npm --prefix apps/project-manager run test:ci",
    "check:frontend": "npm --prefix apps/project-manager run check:frontend",
    "check:backend": "npm --prefix apps/project-manager run check:backend",
    "check": "npm --prefix apps/project-manager run check"
  }
}
