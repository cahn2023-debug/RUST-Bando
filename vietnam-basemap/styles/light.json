{
  "version": 8,
  "name": "Vietnam Basemap Light",
  "metadata": {
    "vietnam-basemap:styleId": "light",
    "vietnam-basemap:contractVersion": "1",
    "vietnam-basemap:offlineAssets": true
  },
  "sources": {
    "vn-basemap": {
      "type": "vector",
      "tiles": ["{basemap-tiles}/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 18
    }
  },
  "glyphs": "{basemap-glyphs}/{fontstack}/{range}.pbf",
  "sprite": "{basemap-sprite}/basemap",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f7f8fa" } },
    { "id": "landcover", "type": "fill", "source": "vn-basemap", "source-layer": "landcover", "paint": { "fill-color": "#eef2e8", "fill-opacity": 0.7 } },
    { "id": "landuse", "type": "fill", "source": "vn-basemap", "source-layer": "landuse", "paint": { "fill-color": "#f1f0e8", "fill-opacity": 0.55 } },
    { "id": "water", "type": "fill", "source": "vn-basemap", "source-layer": "water", "paint": { "fill-color": "#cfe8f6" } },
    { "id": "waterway", "type": "line", "source": "vn-basemap", "source-layer": "waterway", "paint": { "line-color": "#9ed1eb", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 14, 2.2] } },
    { "id": "building", "type": "fill", "source": "vn-basemap", "source-layer": "building", "paint": { "fill-color": "#dedbd5", "fill-outline-color": "#c9c5be", "fill-opacity": 0.8 } },
    { "id": "boundary", "type": "line", "source": "vn-basemap", "source-layer": "boundary", "paint": { "line-color": "#a99bbd", "line-dasharray": [2, 2], "line-width": 1 } },
    { "id": "railway", "type": "line", "source": "vn-basemap", "source-layer": "railway", "paint": { "line-color": "#8b8b8b", "line-dasharray": [2, 2], "line-width": 1.2 } },
    { "id": "ferry-route", "type": "line", "source": "vn-basemap", "source-layer": "ferry", "paint": { "line-color": "#5b9fc4", "line-dasharray": [1, 1], "line-width": 1.4 } },
    { "id": "road-major", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "filter": ["in", ["get", "class"], "motorway", "trunk", "primary"], "paint": { "line-color": "#e18b45", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 12, 3.5, 16, 7] } },
    { "id": "road-minor", "type": "line", "source": "vn-basemap", "source-layer": "transportation", "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 4] } },
    { "id": "airport-label", "type": "symbol", "source": "vn-basemap", "source-layer": "airport", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#4b5965", "text-halo-color": "#ffffff", "text-halo-width": 1 } },
    { "id": "place-label", "type": "symbol", "source": "vn-basemap", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 14, 15] }, "paint": { "text-color": "#3f4650", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } },
    { "id": "poi-label", "type": "symbol", "source": "vn-basemap", "source-layer": "poi", "layout": { "text-field": ["coalesce", ["get", "name_vi"], ["get", "name"], ["get", "name_en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#5d6670", "text-halo-color": "#ffffff", "text-halo-width": 1 } }
  ]
}
