# Firebase Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Google OAuth Configuration (Required for Google Mail/Login)
# Anh lấy thông tin này từ Google Cloud Console (Credentials)
GOOGLE_CLIENT_ID=vào_đây.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=vào_đây

# Collaboration coordinator endpoint
# When set, design sync can call an Apps Script / Drive-backed coordinator instead of local Tauri.
VITE_COLLAB_COORDINATOR_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_COLLAB_SHARED_SECRET=replace_with_a_long_random_secret
